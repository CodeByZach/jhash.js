{
  "name": "jhash.js",
  "version": "3.1.0",
  "description": "A JavaScript hash generator.",
  "main": "jhash.js",
  "files": [
    "jhash.js",
    "jhash.min.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "acorn --ecma2022 --silent jhash.js jhash.min.js && node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeByZach/jhash.js.git"
  },
  "keywords": [
    "hash",
    "md5",
    "sha1",
    "sha256",
    "sha512",
    "ripemd160",
    "hmac",
    "hmac-md5",
    "hmac-sha1",
    "hmac-sha512",
    "hmac-sha256"
  ],
  "author": "CodeByZach <codebyzach@gmail.com>",
  "license": "BSD-2-Clause",
  "bugs": {
    "url": "https://github.com/CodeByZach/jhash.js/issues"
  },
  "homepage": "https://github.com/CodeByZach/jhash.js#readme",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "esbuild": "0.28.2"
  }
}
